{
  "$schema": "https://opencode.ai/config.json",
  "model": "example/fixture-model",
  "skills": [],
  "mcp": {
    "servers": {
      "oauth-remote": {
        "type": "remote",
        "url": "https://mcp.example.test/oauth",
        "oauth": { "clientId": "example-client" }
      },
      "env-header": {
        "type": "remote",
        "url": "https://mcp.example.test/env",
        "headers": { "Authorization": "{env:MCP_TOKEN}" }
      },
      "disabled-stdio": {
        "type": "local",
        "command": ["node", "server.js"],
        "disabled": true
      },
      "bad name!": {
        "type": "remote",
        "url": "https://mcp.example.test/bad"
      }
    }
  }
}
